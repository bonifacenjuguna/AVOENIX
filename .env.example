# AVOENIX v0.0.0 — environment template. PLACEHOLDERS ONLY. Copy to .env (git-ignored) and fill in locally.

# ---- API service (Railway) ----
AVOENIX_ENV=development                     # development | production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
AVOENIX_CORS_ORIGINS=http://localhost:3000  # comma-separated Studio origin(s); never '*'
AVOENIX_ADMIN_EMAIL=admin@example.test
AVOENIX_ADMIN_PASSWORD=                     # >= 12 chars; used once to create the first admin, never stored in clear
AVOENIX_PROJECT_ID=studio
AVOENIX_SESSION_TTL_HOURS=12
AVOENIX_MAX_FAILED_LOGINS=5
AVOENIX_LOCKOUT_MINUTES=15
AVOENIX_RATE_LIMIT_PER_MINUTE=60
AVOENIX_LOGIN_RATE_LIMIT_PER_MINUTE=10
AVOENIX_COOKIE_SECURE=false                 # true in production (HTTPS)
# AVOENIX_EVAL_DATASET=evaluation/datasets/core_v0.json

# ---- docker-compose only ----
POSTGRES_PASSWORD=

# ---- Studio (Vercel) ----
AVOENIX_API_URL=http://localhost:8000       # server-side only; the browser never sees it

# ---- tests (optional) ----
# AVOENIX_TEST_PG=127.0.0.1:54329:avoenix_test
